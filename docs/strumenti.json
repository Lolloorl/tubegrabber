{
  "tools": [
    {
      "id": "estrai-audio", "name": "Estrai audio", "tagline": "Prendi l'audio da qualsiasi video",
      "description": "Trascina uno o più video e ottieni solo l'audio, in MP3, WAV, M4A o FLAC.",
      "examples": ["Video → MP3", "Musica da un concerto"], "color": "#2fc4b2", "icon": "audio", "button": "Estrai audio",
      "input": { "type": "files", "label": "Trascina qui i video", "accept": ["mp4", "mov", "mkv", "avi", "webm", "m4v"] },
      "options": [{ "id": "fmt", "type": "choice", "label": "Formato", "default": "mp3", "choices": [
        { "value": "mp3", "label": "MP3 (il più compatibile)" }, { "value": "wav", "label": "WAV (senza perdita)" },
        { "value": "m4a", "label": "M4A" }, { "value": "flac", "label": "FLAC" }] }],
      "run": { "program": "ffmpeg", "output": "{name}.{fmt}", "args": ["-i", "{input}", "-vn",
        { "when": { "fmt": "mp3" }, "args": ["-c:a", "libmp3lame", "-q:a", "0"] },
        { "when": { "fmt": "wav" }, "args": ["-c:a", "pcm_s16le"] },
        { "when": { "fmt": "m4a" }, "args": ["-c:a", "aac", "-b:a", "256k"] },
        { "when": { "fmt": "flac" }, "args": ["-c:a", "flac"] }, "{output}"] }
    },
    {
      "id": "video-in-gif", "name": "Video in GIF", "tagline": "Crea una GIF animata da un video",
      "description": "Scegli da che secondo partire e quanto deve durare la GIF. Più è piccola e corta, più è leggera.",
      "examples": ["Un momento divertente", "Un'animazione per un sito"], "color": "#f2a93b", "icon": "film", "button": "Crea GIF",
      "input": { "type": "files", "label": "Trascina qui un video", "accept": ["mp4", "mov", "mkv", "avi", "webm", "m4v"] },
      "options": [
        { "id": "start", "type": "number", "label": "Parti dal secondo", "min": 0, "max": 3600, "default": 0 },
        { "id": "secs", "type": "number", "label": "Durata (secondi)", "min": 1, "max": 30, "default": 5 },
        { "id": "width", "type": "number", "label": "Larghezza (pixel)", "min": 120, "max": 1280, "default": 480 },
        { "id": "fps", "type": "number", "label": "Fotogrammi al secondo", "min": 5, "max": 30, "default": 12 }],
      "run": { "program": "ffmpeg", "output": "{name}.gif", "args": ["-ss", "{start}", "-t", "{secs}", "-i", "{input}",
        "-vf", "fps={fps},scale={width}:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse", "-loop", "0", "{output}"] }
    },
    {
      "id": "ruota-video", "name": "Ruota video", "tagline": "Raddrizza un video girato storto",
      "description": "Ruota il video di un quarto di giro a destra o a sinistra, oppure di mezzo giro.",
      "examples": ["Video girato in verticale", "Clip capovolta"], "color": "#9b7bff", "icon": "convert", "button": "Ruota",
      "input": { "type": "files", "label": "Trascina qui i video", "accept": ["mp4", "mov", "mkv", "avi", "webm", "m4v"] },
      "options": [{ "id": "dir", "type": "choice", "label": "Rotazione", "default": "right", "choices": [
        { "value": "right", "label": "90° a destra" }, { "value": "left", "label": "90° a sinistra" }, { "value": "half", "label": "180° (capovolgi)" }] }],
      "run": { "program": "ffmpeg", "output": "{name}_ruotato.mp4", "args": ["-i", "{input}",
        { "when": { "dir": "right" }, "args": ["-vf", "transpose=1"] },
        { "when": { "dir": "left" }, "args": ["-vf", "transpose=2"] },
        { "when": { "dir": "half" }, "args": ["-vf", "transpose=1,transpose=1"] },
        "-c:v", "libx264", "-crf", "20", "-pix_fmt", "yuv420p", "-c:a", "copy", "{output}"] }
    },
    {
      "id": "foto-leggere", "name": "Foto più leggere", "tagline": "Riduci peso e dimensioni delle foto",
      "description": "Ridimensiona le foto e comprimile in JPG: ideali da inviare o pubblicare.",
      "examples": ["Foto da inviare per e-mail", "Immagini per un sito"], "color": "#ff5a5f", "icon": "image", "button": "Riduci foto",
      "input": { "type": "files", "label": "Trascina qui le foto", "accept": ["jpg", "jpeg", "png", "webp"] },
      "options": [
        { "id": "maxw", "type": "choice", "label": "Larghezza massima", "default": "1920", "choices": [
          { "value": "3840", "label": "3840 px (4K)" }, { "value": "1920", "label": "1920 px (Full HD)" }, { "value": "1280", "label": "1280 px" }, { "value": "800", "label": "800 px" }] },
        { "id": "q", "type": "number", "label": "Compressione (2 = migliore, 20 = più leggera)", "min": 2, "max": 20, "default": 5 }],
      "run": { "program": "ffmpeg", "output": "{name}_leggera.jpg", "args": ["-i", "{input}", "-vf", "scale='min({maxw},iw)':-2", "-q:v", "{q}", "-frames:v", "1", "-update", "1", "{output}"] }
    },
    {
      "id": "sottotitoli-youtube", "name": "Sottotitoli YouTube", "tagline": "Scarica i sottotitoli di un video",
      "description": "Incolla uno o più link e ottieni i sottotitoli in formato SRT, senza scaricare il video.",
      "examples": ["Sottotitoli in italiano", "Sottotitoli in inglese"], "color": "#5b8cff", "icon": "tag", "button": "Scarica sottotitoli",
      "input": { "type": "text", "label": "Incolla uno o più link (uno per riga)" },
      "options": [{ "id": "lang", "type": "choice", "label": "Lingua", "default": "it", "choices": [
        { "value": "it", "label": "Italiano" }, { "value": "en", "label": "Inglese" }, { "value": "it,en", "label": "Italiano e inglese" }] }],
      "run": { "program": "yt-dlp", "output": "%(title)s.%(ext)s", "args": ["--skip-download", "--write-subs", "--write-auto-subs", "--sub-langs", "{lang}", "--convert-subs", "srt", "-o", "{output}", "--", "{input}"] }
    }
  ]
}
